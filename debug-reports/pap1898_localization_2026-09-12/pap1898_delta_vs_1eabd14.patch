+// ── 10b. PAP-1898 silhouette-anchored circle fit ───────────────────────────
+// 720-angle inward walk from the mask boundary + trimmed Kasa circle fit.
+// Returns { coverage, fit } (fit null when too few points / degenerate).
+// See the rescue block in findGearCenter above.
+const PAP1898_N_ANG = 720;
+// Each point carries its walk depth (how far inward from the mask boundary
+// the first edge was found). Inner features (bolt circles, spider arms,
+// inner plates) snap angles much DEEPER than the true silhouette, so depth
+// is the outlier signal for the prefit rejection below (QA PAP-1901
+// refinement 1: keep-70% trimming alone converges onto a biased equilibrium
+// for contiguous inner-ring sectors ≥30%).
+function pap1898SilhouettePoints(edges, w, h) {
+  const cx0 = (w - 1) / 2, cy0 = (h - 1) / 2;
+  const maxR = Math.floor(0.49 * Math.min(w, h)) - 6;
+  const pts = [];
+  for (let i = 0; i < PAP1898_N_ANG; i++) {
+    const a = (2 * Math.PI * i) / PAP1898_N_ANG;
+    const ca = Math.cos(a), sa = Math.sin(a);
+    for (let r = maxR; r >= 12; r--) {
+      const px = Math.round(cx0 + r * ca), py = Math.round(cy0 + r * sa);
+      if (px < 0 || px >= w || py < 0 || py >= h) continue;
+      if (edges[py * w + px] > 0) { pts.push({ x: px, y: py, depth: maxR - r }); break; }
+    }
+  }
+  return pts;
+}
+function pap1898KasaFit(pts) {
+  let sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0, sxz = 0, syz = 0, sz = 0;
+  const n = pts.length;
+  for (let k = 0; k < n; k++) {
+    const p = pts[k], z = p.x * p.x + p.y * p.y;
+    sx += p.x; sy += p.y; sxx += p.x * p.x; syy += p.y * p.y;
+    sxy += p.x * p.y; sxz += p.x * z; syz += p.y * z; sz += z;
+  }
+  // Gaussian elimination with partial pivoting on the 3x3 normal equations.
+  const m = [
+    [sxx, sxy, sx, -sxz],
+    [sxy, syy, sy, -syz],
+    [sx, sy, n, -sz],
+  ];
+  for (let i = 0; i < 3; i++) {
+    let piv = i;
+    for (let j = i + 1; j < 3; j++) if (Math.abs(m[j][i]) > Math.abs(m[piv][i])) piv = j;
+    const t = m[i]; m[i] = m[piv]; m[piv] = t;
+    if (Math.abs(m[i][i]) < 1e-9) return null;
+    for (let j = i + 1; j < 3; j++) {
+      const f = m[j][i] / m[i][i];
+      for (let k = i; k < 4; k++) m[j][k] -= f * m[i][k];
+    }
+  }
+  const x = [0, 0, 0];
+  for (let i = 2; i >= 0; i--) {
+    let s = m[i][3];
+    for (let k = i + 1; k < 3; k++) s -= m[i][k] * x[k];
+    x[i] = s / m[i][i];
+  }
+  const D = x[0], E = x[1], F = x[2];
+  const cx = -D / 2, cy = -E / 2;
+  const rr = cx * cx + cy * cy - F;
+  if (!(rr > 0)) return null;
+  return { cx, cy, r: Math.sqrt(rr) };
+}
+function pap1898SilhouetteFit(edges, w, h) {
+  const pts = pap1898SilhouettePoints(edges, w, h);
+  const coverage = pts.length / PAP1898_N_ANG;
+  if (pts.length < 60) return { coverage, fit: null };
+  // Prefit depth rejection (PAP-1901 refinement 1), applied ONLY when inner-
+  // feature latching is actually detected: drop angles whose walk snapped
+  // deeper than median + 3·scaled-MAD — the signature of bolt-circle /
+  // spider-arm sectors, which keep-70% trimming alone cannot fix (the trim
+  // converges onto the sector). The gate arms at ≥12% deep-latched angles;
+  // below that the fit uses every point unchanged, because on real rims a
+  // blind gate shifts the fit by 1-3px and annulus placement is load-bearing
+  // downstream (corpus-measured: PAP-1901 refinement 2). Small gears walk
+  // deep on EVERY angle, so the relative median keeps them by construction.
+  const depths = pts.map(p => p.depth).sort((a, b) => a - b);
+  const med = depths[depths.length >> 1];
+  const absDev = depths.map(d => Math.abs(d - med)).sort((a, b) => a - b);
+  const mad = absDev[absDev.length >> 1];
+  const depthLimit = med + 3 * 1.4826 * mad + 2;
+  const deepPts = pts.filter(p => p.depth > depthLimit);
+  let cur = pts;
+  if (deepPts.length >= 0.12 * pts.length && deepPts.length <= 0.40 * pts.length) {
+    cur = pts.filter(p => p.depth <= depthLimit);
+  }
+  let fit = null;
+  for (let iter = 0; iter < 4 && cur.length > 30; iter++) {
+    fit = pap1898KasaFit(cur);
+    if (!fit) return { coverage, fit: null };
+    const res = cur.map(p => ({ p, d: Math.abs(Math.hypot(p.x - fit.cx, p.y - fit.cy) - fit.r) }));
+    res.sort((a, b) => a.d - b.d);
+    cur = res.slice(0, Math.max(30, Math.floor(cur.length * 0.7))).map(e => e.p);
+  }
+  return { coverage, fit };
+}
+// Rim support of a circle: fraction of 360 rays from (cx, cy) that hit a
+// Canny edge within ±3% of r (min ±2px). The PAP-1898 gate metric — a real
+// gear rim supports ~all of its circle; an inner-feature patch or the mask
+// boundary does not (or, for a mask circle, only where content contrasts).
+function pap1898RimSupport(edges, w, h, cx, cy, r) {
+  let hits = 0;
+  const tol = Math.max(2, 0.03 * r);
+  for (let i = 0; i < 360; i++) {
+    const a = (2 * Math.PI * i) / 360;
+    const ca = Math.cos(a), sa = Math.sin(a);
+    let hit = false;
+    for (let rr = r - tol; rr <= r + tol && !hit; rr++) {
+      const px = Math.round(cx + rr * ca), py = Math.round(cy + rr * sa);
+      if (px < 0 || px >= w || py < 0 || py >= h) continue;
+      if (edges[py * w + px] > 0) hit = true;
+    }
+    if (hit) hits++;
+  }
+  return hits / 360;
+}
